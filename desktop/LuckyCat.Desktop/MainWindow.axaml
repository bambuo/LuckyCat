<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:LuckyCat.Desktop"
        x:Class="LuckyCat.Desktop.MainWindow"
        Title="招财猫"
        Width="1280" Height="800" MinWidth="1080" MinHeight="720"
        Background="#FFFFFF"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36">
  <Grid RowDefinitions="36,*">
    <local:TitleBar Grid.Row="0" x:Name="Bar" />
    <Grid Grid.Row="1">
      <NativeWebView x:Name="Web" />
      <Border x:Name="Splash" Background="#F5F6F8">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <TextBlock x:Name="SplashTitle" Text="正在启动招财猫…" FontSize="14" Foreground="#4E5969" />
          <TextBlock x:Name="SplashDetail" FontSize="12" Foreground="#86909C" TextWrapping="Wrap" MaxWidth="560" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
