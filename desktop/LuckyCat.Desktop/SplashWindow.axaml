<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LuckyCat.Desktop.SplashWindow"
        Title="招财猫"
        Width="420" Height="240"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="#F5F6F8">
  <Grid Margin="32,24,32,20" RowDefinitions="*,Auto">
    <StackPanel Grid.Row="0" Spacing="10" VerticalAlignment="Center">
      <TextBlock x:Name="StatusTitle" Text="正在启动招财猫…"
                 FontSize="14" FontWeight="SemiBold" Foreground="#1D2129" />
      <ScrollViewer MaxHeight="92" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="#86909C" TextWrapping="Wrap" />
      </ScrollViewer>
      <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8"
                  Margin="0,6,0,0" IsVisible="False">
        <Button Content="重试" Padding="16,6" Click="OnRetry" />
        <Button Content="打开日志" Padding="16,6" Click="OnOpenLogs" />
      </StackPanel>
    </StackPanel>
    <Button Grid.Row="1" x:Name="CancelButton" Content="取消"
            Padding="16,6" HorizontalAlignment="Right" Margin="0,10,0,0"
            Click="OnCancel" />
  </Grid>
</Window>
