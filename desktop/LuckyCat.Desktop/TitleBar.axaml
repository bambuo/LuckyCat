<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LuckyCat.Desktop.TitleBar">
  <UserControl.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#4E5969" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav Path">
      <Setter Property="Stroke" Value="#4E5969" />
    </Style>
    <Style Selector="Button.nav TextBlock">
      <Setter Property="Foreground" Value="#4E5969" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#F2F3F5" />
      <Setter Property="Foreground" Value="#1D2129" />
    </Style>
    <Style Selector="Button.nav:pointerover Path">
      <Setter Property="Stroke" Value="#1D2129" />
    </Style>
    <Style Selector="Button.nav:pointerover TextBlock">
      <Setter Property="Foreground" Value="#1D2129" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#FFF4D6" />
      <Setter Property="Foreground" Value="#8A5A00" />
    </Style>
    <Style Selector="Button.nav.active Path">
      <Setter Property="Stroke" Value="#8A5A00" />
    </Style>
    <Style Selector="Button.nav.active TextBlock">
      <Setter Property="Foreground" Value="#8A5A00" />
    </Style>
    <Style Selector="Button.win">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="35" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#4E5969" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.win:pointerover">
      <Setter Property="Background" Value="#F2F3F5" />
    </Style>
    <Style Selector="Button.win Path">
      <Setter Property="Stroke" Value="#4E5969" />
    </Style>
    <Style Selector="Button.win.close:pointerover">
      <Setter Property="Background" Value="#E81123" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.win.close:pointerover Path">
      <Setter Property="Stroke" Value="#FFFFFF" />
    </Style>
  </UserControl.Styles>

  <Border Background="#FFFFFF" BorderBrush="#E5E6EB" BorderThickness="0,0,0,1"
          PointerPressed="OnBarPointerPressed">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                  Margin="12,0,0,0" VerticalAlignment="Center">
        <Image Source="avares://LuckyCat.Desktop/Assets/app.png" Width="20" Height="20"
               VerticalAlignment="Center" />
        <TextBlock Text="招财猫" FontSize="13" FontWeight="SemiBold" Foreground="#1D2129"
                   VerticalAlignment="Center" />
      </StackPanel>

      <Border Grid.Column="1" Width="1" Height="16" Background="#E5E6EB" Margin="10,0"
              VerticalAlignment="Center" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button Classes="nav" Tag="/traders" Click="OnNavClick">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.2"
                  StrokeLineCap="Round" StrokeJoin="Round"
                  Data="M5 6h6a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z M8 3v3 M5.5 10h1 M9.5 10h1"
                  VerticalAlignment="Center" />
            <TextBlock Text="AI 交易员" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="/strategy" Click="OnNavClick">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.2"
                  StrokeLineCap="Round" StrokeJoin="Round"
                  Data="M3 4h10 M3 8h10 M3 12h10 M6 2v4 M10 6v4 M8 10v4"
                  VerticalAlignment="Center" />
            <TextBlock Text="策略工作室" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="/cycles" Click="OnNavClick">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.2"
                  StrokeLineCap="Round" StrokeJoin="Round"
                  Data="M8 2a6 6 0 1 0 0 12A6 6 0 0 0 8 2z M8 5v3.5l2.5 1.5"
                  VerticalAlignment="Center" />
            <TextBlock Text="周期历史" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="/reviews" Click="OnNavClick">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.2"
                  StrokeLineCap="Round" StrokeJoin="Round"
                  Data="M3 3h4a2 2 0 0 1 2 2v8a2 2 0 0 0-2-2H3z M13 3H9a2 2 0 0 0-2 2v8a2 2 0 0 1 2-2h4z"
                  VerticalAlignment="Center" />
            <TextBlock Text="复盘经验" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
        <Button Classes="win" Click="OnMinimize">
          <Path Data="M0,5 H10" StrokeThickness="1" />
        </Button>
        <Button Classes="win" Click="OnToggleMaximize" x:Name="MaxButton">
          <Panel>
            <Path x:Name="MaxIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" StrokeThickness="1" />
            <Path x:Name="RestoreIcon" Data="M2.5,0.5 H9.5 V7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z"
                  StrokeThickness="1" IsVisible="False" />
          </Panel>
        </Button>
        <Button Classes="win close" Click="OnClose">
          <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
